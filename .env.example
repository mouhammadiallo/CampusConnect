# Copy to .env for local use; never commit real credentials.
MONGODB_URI=mongodb://localhost:27017/campusconnect
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
APP_WEB_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
APP_UPLOAD_DIR=./uploads
CAMPUS_MODERATOR_EMAILS=
CAMPUS_ADMIN_EMAILS=
